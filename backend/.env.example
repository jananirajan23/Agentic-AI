# Copy this file to `.env` (in this same backend/ folder) and fill in your
# real values. `.env` is gitignored, so it's safe to put real secrets there.

GROQ_API_KEY=your_groq_api_key_here

# Optional overrides — only set these if you need to pin a specific model.
# See README.md "About the Groq model IDs" for how to pick current ones.
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional: raises Semantic Scholar's very low keyless rate limit.
# SEMANTIC_SCHOLAR_API_KEY=

# --- Auth (faculty login/dashboard) ---
# Required before deploying anywhere reachable by more than one trusted
# person — the default in config.py is dev-only. Generate one with e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`.
# JWT_SECRET=
# JWT_EXPIRE_MINUTES=480

# --- Embeddings (Architecture-Modules Alignment Agent) ---
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_MATCH_THRESHOLD=0.45
